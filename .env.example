GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

DATABASE_URL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_APP_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_SESSION_COOKIE_NAME=creator_session
AUTH_CSRF_COOKIE_NAME=creator_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=creator_video_chunks
REQUIRE_QDRANT_ON_STARTUP=false
QDRANT_CHECK_COMPATIBILITY=false

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

MAX_VIDEO_SECONDS=600
MAX_CONCURRENT_INGESTIONS=2
MAX_CHUNKS_PER_VIDEO=120
MAX_CHAT_HISTORY_MESSAGES=12
MAX_RETRIEVED_CHUNKS=8
MAX_SESSIONS_PER_IP_PER_HOUR=20
INGEST_STALE_SECONDS=900
TMP_DIR=/private/tmp/creator-rag
FORCE_REFRESH=false
YTDLP_COOKIES_PATH=
YTDLP_COOKIES_FROM_BROWSER=

# Comma-separated frontend origins that may call the backend.
# Production example: CORS_ORIGINS=https://your-frontend.onrender.com,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:3000
# Optional regex for preview domains. Keep blank unless you need preview deployments.
# Example: CORS_ORIGIN_REGEX=https://.*\.onrender\.com
CORS_ORIGIN_REGEX=

# Frontend build-time API URL.
# Production example: NEXT_PUBLIC_API_BASE=https://your-backend.onrender.com
NEXT_PUBLIC_API_BASE=http://localhost:8000
